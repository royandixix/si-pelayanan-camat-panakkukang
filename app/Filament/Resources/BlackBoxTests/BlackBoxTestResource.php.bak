<?php

namespace App\Filament\Resources\BlackBoxTests;

use App\Filament\Resources\BlackBoxTests\Pages\EditBlackBoxTest;
use App\Filament\Resources\BlackBoxTests\Pages\ListBlackBoxTests;
use App\Filament\Resources\BlackBoxTests\Schemas\BlackBoxTestForm;
use App\Filament\Resources\BlackBoxTests\Tables\BlackBoxTestsTable;
use App\Models\BlackBoxTest;
use BackedEnum;
use Filament\Resources\Resource;
use Filament\Schemas\Schema;
use Filament\Tables\Table;
use Illuminate\Database\Eloquent\Model;
use UnitEnum;

class BlackBoxTestResource extends Resource
{
    protected static ?string $model = BlackBoxTest::class;

    protected static string|BackedEnum|null $navigationIcon =
        'heroicon-o-clipboard-document-check';

    protected static string|UnitEnum|null $navigationGroup =
        'Data Mining';

    protected static ?string $navigationLabel =
        'Black Box Testing';

    protected static ?string $modelLabel =
        'Black Box Testing';

    protected static ?string $pluralModelLabel =
        'Black Box Testing';

    protected static ?string $recordTitleAttribute =
        'code';

    protected static ?string $slug =
        'black-box-testing';

    protected static ?int $navigationSort = 8;

    protected static bool $hasTitleCaseModelLabel = false;

    public static function form(Schema $schema): Schema
    {
        return BlackBoxTestForm::configure($schema);
    }

    public static function table(Table $table): Table
    {
        return BlackBoxTestsTable::configure($table);
    }

    public static function canViewAny(): bool
    {
        return auth()->user()?->isSuperAdmin() ?? false;
    }

    public static function canCreate(): bool
    {
        return false;
    }

    public static function canEdit(Model $record): bool
    {
        return auth()->user()?->isSuperAdmin() ?? false;
    }

    public static function canDelete(Model $record): bool
    {
        return false;
    }

    public static function canDeleteAny(): bool
    {
        return false;
    }

    public static function shouldRegisterNavigation(): bool
    {
        return auth()->user()?->isSuperAdmin() ?? false;
    }

    public static function getPages(): array
    {
        return [
            'index' => ListBlackBoxTests::route('/'),
            'edit' => EditBlackBoxTest::route('/{record}/hasil'),
        ];
    }
}
